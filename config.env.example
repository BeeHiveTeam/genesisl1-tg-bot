# Telegram credentials. configure.py prompts for the token without echo.
BOT_TOKEN=
ALLOWED_CHAT_IDS=
# Main validator CometBFT RPC.
RPC_URL=http://127.0.0.1:26657
CHAIN_ID=genesis_29-2
SERVICE=genesisl1.service
VALCONS=
VALOPER=
STATE_PATH=/var/lib/genesisl1-tg-bot/state.json
CHECK_INTERVAL=60
# Blank values derive warnings at 10% and critical alerts at 80% of allowed misses.
MISSED_WARN=
MISSED_CRIT=
MISSED_WARN_HYSTERESIS=50
MISSED_WARN_STEP=100
MISSED_WARN_REMINDER_SEC=3600
MISSED_ALERT_MIN_GAP=900
SIGNING_FAIL_ALERT_TICKS=3
PEERS_FAIL_ALERT_TICKS=5
PEERS_MIN=3
BLOCK_LAG_WARN_SEC=45
DISK_WARN_PCT=85
STALL_TICKS=3
PENDING_MAX=50
PENDING_TTL_SEC=21600
LANG=ru
