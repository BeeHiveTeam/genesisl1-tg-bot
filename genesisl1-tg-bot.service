[Unit]
Description=GenesisL1 validator Telegram monitoring
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=genesisl1-bot
Group=genesisl1-bot
ExecStart=/usr/bin/python3 /opt/genesisl1-tg-bot/bot.py
WorkingDirectory=/opt/genesisl1-tg-bot
Restart=on-failure
RestartSec=15
StateDirectory=genesisl1-tg-bot
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
InaccessiblePaths=-/var/lib/genesisl1 -/etc/ssl/private
CPUQuota=10%
CPUWeight=10
MemoryMax=128M
TasksMax=32
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
